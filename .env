# -----------------------------------------------------------------------------
# BACKEND FASTAPI (Plataforma Logística)
# -----------------------------------------------------------------------------
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
SECRET_KEY=nike-logistica-super-secret-jwt-key-2025-dev-only
DEMO_MODE=True
DEMO_ROLE_HEADER=X-Demo-Role
CORS_ORIGINS=http://intranet.nike.com,http://localhost:5173

# GROQ API — LLM del Chatbot
GROQ_API_KEY=LLM
GROQ_MODEL=llama-3.1-8b-instant
GROQ_MAX_TOKENS=2048
GROQ_TEMPERATURE=0.3

# Embeddings (pgvector)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
VECTOR_SIMILARITY_THRESHOLD=0.95

# -----------------------------------------------------------------------------
# FRONTEND REACT (Vite)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://intranet.nike.com/api/v1
VITE_PROXY_TARGET=http://backend:8000
VITE_KEYCLOAK_ENABLED=true
VITE_KEYCLOAK_URL=http://auth.nike.com
VITE_KEYCLOAK_REALM=nike
VITE_KEYCLOAK_CLIENT_ID=nike-backend

# -----------------------------------------------------------------------------
# PGADMIN (herramienta visual opcional, --profile tools)
# -----------------------------------------------------------------------------
PGADMIN_EMAIL=admin@nike.pe
PGADMIN_PASSWORD=pgAdmin2025_Nike!
PGADMIN_PORT=5050

# -----------------------------------------------------------------------------
# BACKUP
# -----------------------------------------------------------------------------
BACKUP_RETENTION_DAYS=7
BACKUP_DIR=/opt/nike-backups

