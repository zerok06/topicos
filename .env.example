# =============================================================================
# NIKE ENTERPRISE PLATFORM - VARIABLES DE ENTORNO (EJEMPLO)
# =============================================================================
# Copia este archivo como .env y reemplaza los valores marcados con CHANGE_ME
# =============================================================================

# -----------------------------------------------------------------------------
# GENERAL
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=nike
SERVER_IP=CHANGE_ME_SERVER_IP
DOMAIN_SUFFIX=nike.com
TIMEZONE=America/Bogota

# -----------------------------------------------------------------------------
# VERSIONES DE IMÁGENES (pinned)
# -----------------------------------------------------------------------------
TRAEFIK_VERSION=v3.7.4
ADGUARD_VERSION=v0.107.77
PORTAINER_VERSION=2.39.3
KEYCLOAK_VERSION=26.6.3
POSTGRES_VERSION=17.10-bookworm
GITEA_VERSION=1.26.2
PROMETHEUS_VERSION=v3.12.0
GRAFANA_VERSION=13.0.2
NODE_EXPORTER_VERSION=v1.11.1
WGEASY_VERSION=15
NGINX_VERSION=1.27-alpine
PGVECTOR_VERSION=pg16
REDIS_ALPINE_VERSION=7-alpine

# -----------------------------------------------------------------------------
# POSTGRESQL INFRAESTRUCTURA (keycloak, gitea, grafana)
# -----------------------------------------------------------------------------
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_KEYCLOAK_DB=keycloak
POSTGRES_GITEA_DB=gitea
POSTGRES_GRAFANA_DB=grafana

# -----------------------------------------------------------------------------
# POSTGRESQL LOGÍSTICA (4 DBs independientes)
# -----------------------------------------------------------------------------
DB_CENTRAL_USER=CHANGE_ME
DB_CENTRAL_PASSWORD=CHANGE_ME
DB_CENTRAL_NAME=nike_logistica_db
DB_CENTRAL_PORT=5432

DB_SEDE_USER=CHANGE_ME
DB_SEDE_PASSWORD=CHANGE_ME
DB_SEDE_NAME=nike_sede_peru_db
DB_SEDE_PORT=5433

DB_RETAIL_USER=CHANGE_ME
DB_RETAIL_PASSWORD=CHANGE_ME
DB_RETAIL_NAME=nike_retail_db
DB_RETAIL_PORT=5434

DB_SUPPLY_USER=CHANGE_ME
DB_SUPPLY_PASSWORD=CHANGE_ME
DB_SUPPLY_NAME=nike_supply_chain_db
DB_SUPPLY_PORT=5435

# URLs locales para desarrollo (fuera de Docker)
DATABASE_URL_CENTRAL=postgresql+asyncpg://CHANGE_ME:CHANGE_ME@localhost:5432/CHANGE_ME
DATABASE_URL_CENTRAL_SYNC=postgresql://CHANGE_ME:CHANGE_ME@localhost:5432/CHANGE_ME
DATABASE_URL_SEDE=postgresql+asyncpg://CHANGE_ME:CHANGE_ME@localhost:5433/CHANGE_ME
DATABASE_URL_SEDE_SYNC=postgresql://CHANGE_ME:CHANGE_ME@localhost:5433/CHANGE_ME
DATABASE_URL_RETAIL=postgresql+asyncpg://CHANGE_ME:CHANGE_ME@localhost:5434/CHANGE_ME
DATABASE_URL_RETAIL_SYNC=postgresql://CHANGE_ME:CHANGE_ME@localhost:5434/CHANGE_ME
DATABASE_URL_SUPPLY=postgresql+asyncpg://CHANGE_ME:CHANGE_ME@localhost:5435/CHANGE_ME
DATABASE_URL_SUPPLY_SYNC=postgresql://CHANGE_ME:CHANGE_ME@localhost:5435/CHANGE_ME

# -----------------------------------------------------------------------------
# REDIS — Caché Semántica
# -----------------------------------------------------------------------------
REDIS_HOST=CHANGE_ME
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
REDIS_DB=0

# -----------------------------------------------------------------------------
# KEYCLOAK
# -----------------------------------------------------------------------------
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=CHANGE_ME
KC_DB_URL=jdbc:postgresql://postgres:5432/keycloak
KC_DB_USERNAME=CHANGE_ME
KC_DB_PASSWORD=CHANGE_ME
KC_HOSTNAME=http://auth.nike.com
KC_HTTP_PORT=8080
KC_REALM_NAME=nike

KEYCLOAK_ENABLED=true
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=nike
KEYCLOAK_CLIENT_ID=nike-backend
KEYCLOAK_CLIENT_SECRET=CHANGE_ME
KEYCLOAK_ALGORITHM=RS256

# -----------------------------------------------------------------------------
# GITEA
# -----------------------------------------------------------------------------
GITEA_DB_TYPE=postgres
GITEA_DB_HOST=postgres:5432
GITEA_DB_NAME=gitea
GITEA_DB_USER=CHANGE_ME
GITEA_DB_PASSWD=CHANGE_ME
GITEA_SECRET_KEY=CHANGE_ME
GITEA_INTERNAL_TOKEN=CHANGE_ME
GITEA_SSH_PORT=2222
GITEA_DOMAIN=git.nike.com
GITEA_ROOT_URL=http://git.nike.com

# -----------------------------------------------------------------------------
# GRAFANA
# -----------------------------------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME
GF_SERVER_ROOT_URL=http://grafana.nike.com
GF_SERVER_DOMAIN=grafana.nike.com
GF_DATABASE_TYPE=postgres
GF_DATABASE_HOST=postgres:5432
GF_DATABASE_NAME=grafana
GF_DATABASE_USER=CHANGE_ME
GF_DATABASE_PASSWORD=CHANGE_ME

# -----------------------------------------------------------------------------
# PROMETHEUS
# -----------------------------------------------------------------------------
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=5GB

# -----------------------------------------------------------------------------
# WIREGUARD (wg-easy)
# -----------------------------------------------------------------------------
WG_PASSWORD=CHANGE_ME
WG_HOST=CHANGE_ME_SERVER_IP
WG_PORT=51820
WG_DEFAULT_DNS=CHANGE_ME_SERVER_IP

# -----------------------------------------------------------------------------
# PORTAINER
# -----------------------------------------------------------------------------
PORTAINER_ADMIN_PASSWORD=CHANGE_ME

# -----------------------------------------------------------------------------
# ADGUARD HOME
# -----------------------------------------------------------------------------
ADGUARD_USER=admin
ADGUARD_PASSWORD_HASH=CHANGE_ME

# -----------------------------------------------------------------------------
# BACKEND FASTAPI (Plataforma Logística)
# -----------------------------------------------------------------------------
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
SECRET_KEY=CHANGE_ME
DEMO_MODE=True
DEMO_ROLE_HEADER=X-Demo-Role
CORS_ORIGINS=http://intranet.nike.com,http://localhost:5173

GROQ_API_KEY=CHANGE_ME
GROQ_MODEL=llama-3.1-8b-instant
GROQ_MAX_TOKENS=2048
GROQ_TEMPERATURE=0.3

EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
VECTOR_SIMILARITY_THRESHOLD=0.95

# -----------------------------------------------------------------------------
# FRONTEND REACT (Vite)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://intranet.nike.com/api/v1
VITE_PROXY_TARGET=http://backend:8000
VITE_KEYCLOAK_ENABLED=true
VITE_KEYCLOAK_URL=http://auth.nike.com
VITE_KEYCLOAK_REALM=nike
VITE_KEYCLOAK_CLIENT_ID=nike-backend

# -----------------------------------------------------------------------------
# PGADMIN (herramienta visual opcional, --profile tools)
# -----------------------------------------------------------------------------
PGADMIN_EMAIL=admin@nike.pe
PGADMIN_PASSWORD=CHANGE_ME
PGADMIN_PORT=5050

# -----------------------------------------------------------------------------
# BACKUP
# -----------------------------------------------------------------------------
BACKUP_RETENTION_DAYS=7
BACKUP_DIR=/opt/nike-backups

