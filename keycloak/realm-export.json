  "clients": [
    {
      "clientId": "gitea",
      "name": "Gitea",
      "description": "Git repository — OAuth2/OIDC",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "gitea-client-secret-change-me-2026",
